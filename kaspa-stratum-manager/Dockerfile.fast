# syntax=docker/dockerfile:1.7

# Application-only builds reuse the bridge and runtime from the last immutable release.
FROM ghcr.io/noillion-labs/kaspa-stratum-manager:1.3.0@sha256:fe7075cd5897c2cb20291728213f59b9c325912f48ffce2268b0bbb439ef8fd7 AS release-base

FROM node:24.19.0-bookworm-slim AS app-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash coreutils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY . .
RUN find scripts docker -type f -name '*.sh' -exec sed -i 's/\r$//' {} +
RUN npm run build

FROM release-base AS runtime
ARG KSM_DONATION_KASPA_ADDRESS=""
ARG KSM_DONATION_BITCOIN_ADDRESS=""
USER root
RUN rm -rf /opt/kaspa-stratum-manager
COPY --from=app-build --chown=node:node /app /opt/kaspa-stratum-manager
COPY --from=app-build /app/docker/entrypoint.sh /usr/local/bin/kaspa-manager-entrypoint
RUN chmod 0755 /usr/local/bin/kaspa-manager-entrypoint
LABEL org.opencontainers.image.version="fast" \
      io.kaspa.release.workflow="fast-push"
ENV KSM_DONATION_KASPA_ADDRESS="${KSM_DONATION_KASPA_ADDRESS}" \
    KSM_DONATION_BITCOIN_ADDRESS="${KSM_DONATION_BITCOIN_ADDRESS}"
USER node
